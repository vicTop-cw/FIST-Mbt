#!/bin/sh
# FIST-Mbt pre-commit 钩子（TASK-001② + R179）：冲突标记不许进 commit；gitlink 不许进索引。
#
# 为什么这几道门（缺一不可）：
#   0) **gitlink 门（R179）**：本仓 `git worktree list` 注册了 51 个 worktree，每个目录根都有
#      一个 `.git` 文件，一次 `git add -A` 就会把它们记成 mode 160000 的 gitlink 写进索引。
#      4a7bf82a 的真实事故就是这么来的（`.agents/worktrees/fix/display-rank-boundary` 进了跟踪面，
#      `check_merge_markers` 等判据「读不到正文」）。gitlink 进了历史就**修不掉**（`git rm --cached`
#      只挡下一次），所以只能卡在提交前。判据真源 = `scripts/check_index_gitlinks.py`（19 格自证）。
#   1) 先让冲突标记判据自证（--selftest）：尺子本身坏了就拒绝放行，不许"绿得不知所以"；
#   2) live 扫全跟踪面：标记进跟踪面后 CI 只能事后知道——259b56a8 就是这么带 3 处标记进
#      master 的（`.mbt` 带标记直接崩编译，`moon build` 报一片 Error）；
#   3) `git diff --cached --check`：兜住暂存面里的行首标记/尾随空格一类"提交前就能看见"的脏。
# 环境变量：
#   FIST_PRECOMMIT_SKIP_MOON=1  跳过 moon check（本机依赖缓存/格式化器未预热时用；CI 仍会查）
#
# 任何一道门判红 ⇒ exit 1。`--no-verify` 不是"通行证"：CI 侧另有同名判据兜底。
set -e

PY=python3
command -v "$PY" >/dev/null 2>&1 || PY=python
command -v "$PY" >/dev/null 2>&1 || { echo "error: 找不到 python/python3 —— 判据无从运行，拒绝提交" >&2; exit 1; }

# ── 门 0：索引面 gitlink（mode 160000）硬门 ────────────────────────────────────────────
# 两次判定：先自证尺子（坏了就拒），再判**本次暂存面**（只拦本次提交，不因历史存量误拦）。
GITLINK="scripts/check_index_gitlinks.py"
if [ -f "$GITLINK" ]; then
  echo "[pre-commit] 0/4 gitlink 判据自证（--selftest）..."
  if ! "$PY" "$GITLINK" --selftest; then
    echo "error: check_index_gitlinks.py 自检失败——尺子本身坏了，拒绝提交（别用 --no-verify 绕过）" >&2
    exit 1
  fi
  echo "[pre-commit] 0/4 判本次暂存面有没有 gitlink（mode 160000）..."
  if ! "$PY" "$GITLINK" --staged; then
    echo "" >&2
    echo "error: 索引里出现 gitlink(mode 160000) —— 提交被拒。" >&2
    echo "       本仓**没有** .gitmodules，出现 160000 只说明某个 agent 的 worktree 目录被" >&2
    echo "       \`git add -A\` 之类的宽 add 带进了暂存面（51 个已注册 worktree = 51 颗雷）。" >&2
    echo "       按上面「修法」逐条执行后再提交，最短形是：" >&2
    echo "         git rm --cached -f -- \"<上面点名的路径>\"" >&2
    echo "         git check-ignore -v -- \".agents/worktrees/\"   # 确认 .gitignore 护栏命中" >&2
    echo "       不要用 --no-verify 绕过：gitlink 进了历史就只能改写历史。" >&2
    exit 1
  fi
else
  echo "[pre-commit] 警告：$GITLINK 不存在（不在仓库根？），跳过 gitlink 判据" >&2
fi

# ── 门：暂存面 scripts/*.py 的三条静态体检（E1 / A1 / A2）──────────────
# 放这里的理由：本门**不依赖任何前置分支**（不像门 4 只在含 MoonBit 源时跑）。
# 三条规则都来自本场实测（详见 scripts/_new_script_hygiene.py 头注释）：
#   E1 = 打印中文却没带 stdout reconfigure 门（R63/R64 新增判据全中，红了两轮没人发现）；
#   A1 = `if a != "--selftest"` 把**位置参数**判成未知（R65 的 12 把全中）；
#   A2 = 用 `sys.argv`（含 argv[0]）判未知 ⇒ 脚本自身路径被当旗标 ⇒ 恒 rc=2。
# 只判**本次暂存面**，不看全仓 ⇒ 不会被别的 lane 的 WIP 误拦。
HYGIENE="scripts/_new_script_hygiene.py"
if [ -f "$HYGIENE" ]; then
  STAGED_PY_LIST="$(git diff --cached --name-only --diff-filter=ACM -- scripts/ | grep "\.py$" || true)"
  if [ -n "$STAGED_PY_LIST" ]; then
    echo "[pre-commit] 暂存脚本体检（尺子自证 + E1/A1/A2）..."
    if ! "$PY" "$HYGIENE" --selftest >/dev/null; then
      echo "error: _new_script_hygiene.py 自检失败——尺子本身坏了，拒绝提交" >&2
      exit 1
    fi
    if ! printf "%s\n" "$STAGED_PY_LIST" | xargs "$PY" "$HYGIENE"; then
      echo "error: 暂存脚本体检不通过 —— 提交被拒（按上方逐条修，别用 --no-verify 绕）" >&2
      exit 1
    fi
  fi
fi

# ── 门 1/2：冲突标记 ────────────────────────────────────────────────────────────────
MARKER="scripts/blackbox/check_merge_markers.py"
if [ -f "$MARKER" ]; then
  echo "[pre-commit] 1/4 冲突标记判据自证（--selftest）..."
  if ! "$PY" "$MARKER" --selftest; then
    echo "error: check_merge_markers.py 自检失败——尺子本身坏了，拒绝提交（别用 --no-verify 绕过）" >&2
    exit 1
  fi
  echo "[pre-commit] 2/4 扫描跟踪面冲突标记（live）..."
  if ! "$PY" "$MARKER"; then
    echo "error: 跟踪面存在未解决冲突标记——先解干净再提交" >&2
    exit 1
  fi
else
  echo "[pre-commit] 警告：$MARKER 不存在（不在仓库根？），跳过标记判据" >&2
fi

echo "[pre-commit] 3/4 暂存面 check（git diff --cached --check）..."
if ! git diff --cached --check; then
  echo "error: 暂存面有冲突标记/尾随空格一类问题——修完再提交" >&2
  exit 1
fi

# ── 门 4：moon check（只在暂存面**含 MoonBit 源**时跑）──────────────────────────
# 为什么加这个判定：moon check 编译的是**整个工作树**，别人未提交的半成品同样会被编到。
# 于是纯文档提交会被与它无关的 WIP 挡住。2026-10-28 实测：一笔只改 `reports/*.md` 的提交
# 被另一 agent 的瞬时 1 error 拒了两次（`27 warnings, 1 errors`），内容一字未改再提交就过。
# 文档/脚本改动不可能让 moon check 失败 ⇒ 跳过不放弃任何真实风险；有源改动仍照跑，
# CI 侧也有同名判据兜底（`--no-verify` 不是通行证，见文件头）。
# 判定口径：`*.mbt` / `*.mbti` / `moon.pkg` / `moon.mod`（含子包路径）任一进暂存面就跑。
staged_moon_sources() {
  git diff --cached --name-only | grep -E '(^|/)moon\.(pkg|mod)$|\.(mbt|mbti)$' || true
}
MOON_SRC_STAGED="$(staged_moon_sources)"

# FIST_PRECOMMIT_DECIDE_ONLY=1：只打印本门判定、不执行任何检查（判定口径的自证缝）。
if [ "${FIST_PRECOMMIT_DECIDE_ONLY:-0}" = "1" ]; then
  if [ -z "$MOON_SRC_STAGED" ]; then
    echo "DECIDE=skip-moon-check（暂存面无 MoonBit 源）"
  else
    echo "DECIDE=run-moon-check（暂存面含：$(echo "$MOON_SRC_STAGED" | tr '\n' ' ')）"
  fi
  exit 0
fi

if [ "${FIST_PRECOMMIT_SKIP_MOON:-0}" = "1" ]; then
  echo "[pre-commit] 已按 FIST_PRECOMMIT_SKIP_MOON=1 跳过 moon check（CI 仍会查）"
  exit 0
fi

if [ -z "$MOON_SRC_STAGED" ]; then
  echo "[pre-commit] 4/4 跳过 moon check：暂存面没有 MoonBit 源（文档/数据类提交）"
  exit 0
fi

if ! command -v moon >/dev/null 2>&1; then
  echo "error: moon not found on PATH; install it or set FIST_PRECOMMIT_SKIP_MOON=1" >&2
  exit 1
fi

echo "[pre-commit] 4/4 moon check（暂存面含 MoonBit 源）..."
moon check
