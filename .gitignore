.DS_Store
_build/
/target/
.mooncakes/
.moonagent/
# build/test logs
*.log
# sqlite e2e test dbs
*.db
# 自我迭代数据库（评审可查的原始记档，随每轮稳定一并同步入库）
# temp scripts (m9_*, m18_*, etc.)
m9_*.js
m18_*.js
# atomcode project dir
.atomcode/
# 项目申报书（个人参赛文档，不入仓库）
项目申报书.md
项目申报书.pdf
# generated interface files (optional - uncomment to exclude)
# *.mbti
# pkg.generated.mbti

temp/
# sqlite runtime files (wal/shm)
*.db-shm
*.db-wal
# cron runtime state & scratch scripts（仅仓库根目录的运行时状态）
/.cron_state_*.json
__pycache__/
execute_cron.py
_cron_executor.py
_cron_query.py
# IDE / scratch transient
.trae/
.office-claw/
_cron_tmp_sends.jsonl
# blackbox release artifacts
_release/
memory/bugs_pending_github.json

# 构建产物
dist/
!dist/
!dist/*

# moon 生成的 pkg 临时件——`moon publish` 的打包面 = 工作树减 .gitignore（不是 git 跟踪面），
# 0.3.4 发布载荷实测带上了 __cli_pkg.mbt.tmp（552 件里唯一不在 git 里的）⇒ 这类残留必须挡在 ignore 面
*.mbt.tmp

# 仓库根 `.mcp.json` = 本机 MCP 连接器在读的那一份：未跟踪、内容与跟踪真源 .mcp.dev.json 逐字节相同。
# BUG-131 之后投影已按跟踪面优先解析，这里再把它挡在 ignore 面 ⇒ `git status` 与「工作树 − .gitignore」两面都干净。
# 只锚仓库根（plugins/claude/.mcp.json 是跟踪件，不许被这条规则盖住）。
/.mcp.json
