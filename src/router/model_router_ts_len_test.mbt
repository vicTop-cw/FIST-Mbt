///|
/// R41：`iso_to_secs` 的**长度与分隔符边界**契约锁。
///
/// 来源：issue_scan 扫 src/router 命中 `model_router.mbt` L487-492 的
/// `string-index` + `possible-overflow` finding（`dig[0..18]`）。复核 L455 发现
/// **长度 <19 已 return -1**、L464-472 已检查所有关键下标非负、L500 已限 y∈[1970,2037]
/// （BUG-218 修复）→ 该 finding 是**假阳性**（dig 值 ≤9，乘积 ≤9000 不溢出）。
///
/// 但**防御本身缺锁**：现有锁 `rt_2b` 只测合法输入与 Y2038 边界（2037 合法/2038 -1），
/// 若未来有人删掉 L455 的长度守卫，`dig[18]` 会越界 panic，而现有锁**不会红**（都喂合法输入）。
/// 本锁钉死长度 <19 与分隔符形状必须返回 -1 的契约。

///|
/// 空串 → -1。
test "caf_ts_1_空串返回-1" {
  if iso_to_secs("") != -1 {
    abort("空串应返回 -1")
  }
}

///|
/// 长度不足 19 → -1（否则 `dig[18]` 越界 panic）。
/// "2037-12-31T00:00:0" 是 18 字符，缺秒位最后一个数字。
/// 注：初次写作 "2037-12-31T00:00:00"（19 字符）会红——那是**合法完整格式**（无 Z 后缀）。
test "caf_ts_2_长度不足19返回-1" {
  if iso_to_secs("2037-12-31T00:00:0") != -1 {
    abort("18 字符时间戳应返回 -1")
  }
}

///|
/// 19 字符（无 Z 后缀）也合法：YYYY-MM-DDTHH:MM:SS 正好 19 字符，L455 `length()<19`
/// 放过 19，继续走分隔符与数值检查。此契约补 rt_2b（只测 20 字符带 Z 场景）。
test "caf_ts_6_19字符无Z后缀合法" {
  if iso_to_secs("2037-12-31T00:00:00") <= 0 {
    abort("19 字符无 Z 时间戳应返回正数秒")
  }
}

///|
/// 完全非时间戳的字符串 → -1（`dig` 全为 -1，bad_digit 触发）。
test "caf_ts_3_非时间戳返回-1" {
  if iso_to_secs("not-a-timestamp") != -1 {
    abort("非时间戳应返回 -1")
  }
}

///|
/// 合法 20 字符时间戳 → 正数秒。
test "caf_ts_4_合法时间戳返回正数" {
  if iso_to_secs("2037-12-31T00:00:00Z") <= 0 {
    abort("2037-12-31T00:00:00Z 应返回正数秒")
  }
}

///|
/// 分隔符形状错（位置 4 不是 '-'）→ -1。
test "caf_ts_5_分隔符错返回-1" {
  if iso_to_secs("2037 12-31T00:00:00Z") != -1 {
    abort("分隔符形状错应返回 -1")
  }
}
