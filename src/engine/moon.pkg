import {
  "vicTop-cw/fist-mbt/src/core",
  "vicTop-cw/fist-mbt/src/store",
  "vicTop-cw/fist-mbt/src/decompose",
  "vicTop-cw/fist-mbt/src/omega",
  "vicTop-cw/fist-mbt/src/evolve",
  "vicTop-cw/fist-mbt/src/executor",
  // T0r2：claim 路径接逻辑项互斥闸（claimguard），引擎侧唯一新增依赖
  "vicTop-cw/fist-mbt/src/claimguard",
  "moonbitlang/core/json",
  // BUG-478：auth_mode.mbt 用 @env.get_env_var ⇒ 显式导入（原先靠隐式解析，已弃用）
  "moonbitlang/core/env",
  // BUG-478 补：R38 加显式 `extend ... with @moonbitlang/core/debug.Debug::{to_repr}` 时
  // 用了该包但未 import ⇒ 引入 3 个 core_package_not_imported（auth_mode.mbt:53 / engine.mbt:1597/1615）。
  "moonbitlang/core/debug",
  "moonbitlang/core/math",
  "moonbitlang/x/fs",
  "moonbitlang/core/encoding/utf8",
  "cc06b/mooncry/lib" @mooncry,
}

supported_targets = "js+native"

warnings = "-6" // multi-target unused_package suppression (align with server)

options(
  link: { "native": { "cc-link-flags": "-lsqlite3" } },
)
