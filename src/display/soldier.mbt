///|
/// display/soldier.mbt —— 士兵分类展示层（§8.2 兵种 × 模型档位 × 攻坚任务类型）。
///
/// 真源：docs/2026-10-12-fist-mbt-web-dashboard-plan.md §8.2「士兵分类表（兵种 × 模型档位 × 攻坚任务类型）」。
///
/// 设计原则（引自 docs）：
///   士兵（`Executor`）按「任务性质 × 模型档位」细分为 8 个兵种，供路由与面板展示标签使用。
///   **展示层，非协议枚举**：协议层仍只有 `Executor` 一个角色；兵种只是展示标签，协议与存储零改动。
///
/// 分类规则（引自 docs 表）：
///   侦查兵 ← Searcher + 便宜快速模型（情报搜集/可行性调研）
///   骑兵   ← 轻载执行 + 低延迟中端模型（短平快/高频小任务）
///   炮兵   ← 重载执行 + 强力模型（大重构/算法攻坚）
///   特种兵 ← 白名单专属 + 最强模型（高价值关键任务/紧急修复/架构决策）
///   工兵   ← 工具链 + 通用模型（环境搭建/依赖修复）
///   医疗兵 ← 排障 + 中端模型（错误修复/故障恢复/数据抢救）
///   通信兵 ← 通知 + 快速模型（消息同步/状态汇报/提醒）
///   后勤兵 ← 资源管理 + 通用模型（文件整理/资源分配/归档）
///
/// 路由联动（§8.3）：兵种 ↔ `model_route` 池标签（free/paid/Star 门）映射见 `pool_label_of`。
/// 实施前提仍属远期变更（core_role 新增 Reminder / Executor 兵种元数据），本期仅占位实现展示层。

///|
/// 士兵分类标签数组（8 兵种，顺序与 docs §8.2 表一致）。
pub fn soldier_types() -> Array[String] {
  [
    "侦查兵", "骑兵", "炮兵", "特种兵", "工兵", "医疗兵", "通信兵",
    "后勤兵",
  ]
}

///|
/// 兵种数（8）。
pub fn soldier_type_count() -> Int32 {
  8
}

///|
/// 兵种角色映射（展示层）：把任务关键词映射到 8 兵种之一。
/// 按 docs §8.2 攻坚任务类型的关键词匹配，未知回退到「工兵」（工具链 + 通用模型，最通用）。
/// 参数：keywords(可选，任务描述关键词，逗号/空格分隔)。
///
/// 匹配表的**顺序必须与 `soldier_types()` 一致**（侦查兵→骑兵→炮兵→特种兵→工兵→
/// 医疗兵→通信兵→后勤兵）：多词命中时**先出现的兵种优先**，顺序即优先级。
/// 此前顺序与 `soldier_types()` 不一致（骑兵/工兵被排到末尾、医疗兵提前），
/// 导致「修复 环境」「脚本 批量」这类多命中关键词的归类随表序漂移、违背文档定的优先级。
///
/// ⚠️ **表序即优先级**（first-match-wins，不按命中次数打分）：文本同时含多类关键词时，
/// 由下面的表序决定 —— 如「修复 install 失败」同时命中 `install`(工兵) 与 `修复`(医疗兵)，
/// 因为工兵排在医疗兵之前 ⇒ 返回 **工兵**。这是**既有行为**（已由 69 格测试里的单类用例锁定，
/// 但复合文本没有用例）。改成分数制或调序都属**行为变更**，不在这笔里做 ——
/// 若确实要「具体优先于通用」，应把工兵（兼默认回退档）移到医疗/通信/后勤之后并补复合文本用例。
///
pub fn soldier_type_of(keywords : String) -> String {
  let kw = keywords
  if kw.is_empty() {
    return "工兵"
  }
  let table = [
    (
      "侦查兵",
      [
        "情报", "调研", "搜索", "文档", "速读", "search", "research", "feasibility",
      ],
    ),
    (
      "骑兵",
      [
        "短平快", "高频", "批量", "琐事", "quick", "fast", "batch", "bulk",
      ],
    ),
    (
      "炮兵",
      [
        "重构", "算法", "攻坚", "疑难", "排障", "refactor", "algorithm",
        "hard",
      ],
    ),
    (
      "特种兵",
      ["高价值", "关键", "紧急", "架构", "critical", "urgent", "arch"],
    ),
    (
      "工兵",
      [
        "环境", "依赖", "脚本", "搭建", "build", "env", "script", "install",
      ],
    ),
    (
      "医疗兵",
      ["修复", "故障", "恢复", "抢救", "fix", "recover", "bug", "error"],
    ),
    (
      "通信兵",
      [
        "消息", "同步", "汇报", "提醒", "通知", "notify", "sync", "report",
      ],
    ),
    (
      "后勤兵",
      ["整理", "分配", "归档", "资源", "organize", "archive", "alloc"],
    ),
  ]
  let kws = kw.to_lower()
  for i = 0; i < table.length(); i = i + 1 {
    let (_, tags) = table[i]
    for j = 0; j < tags.length(); j = j + 1 {
      if kws.contains(tags[j]) {
        return table[i].0
      }
    }
  }
  "工兵"
}

///|
/// 兵种 → 模型池标签映射（§8.3 展示层，非协议）。
/// 特种兵/炮兵 → 付费/旗舰池（重任务高价值）；侦查兵/骑兵/通信兵 → 免费池（轻任务）；
/// 其余 → 通用池（常规策略）。
pub fn pool_label_of(soldier : String) -> String {
  match soldier {
    "特种兵" => "paid-premium"
    "炮兵" => "paid-flagship"
    "侦查兵" => "free-fast"
    "骑兵" => "free-mid"
    "通信兵" => "free-fast"
    "工兵" => "free-general"
    "医疗兵" => "free-mid"
    "后勤兵" => "free-general"
    _ => "free-general"
  }
}

///|
/// 兵种攻坚任务类型说明（展示层，供面板/汇报文案）。
pub fn soldier_mission(soldier : String) -> String {
  match soldier {
    "侦查兵" => "情报搜集 / 可行性调研 / 搜索与文档速读"
    "骑兵" => "短平快 / 高频小任务 / 批量琐事"
    "炮兵" => "大重构 / 算法攻坚 / 疑难排障"
    "特种兵" => "高价值关键任务 / 紧急修复 / 架构决策"
    "工兵" => "环境搭建 / 依赖修复 / 脚本编写"
    "医疗兵" => "错误修复 / 故障恢复 / 数据抢救"
    "通信兵" => "消息同步 / 状态汇报 / 提醒"
    "后勤兵" => "文件整理 / 资源分配 / 归档"
    _ => "未知兵种"
  }
}

///|
/// 兵种 ↔ 模型档位说明（展示层，供路由监控面板「兵种分布」视图）。
pub fn soldier_model_tier(soldier : String) -> String {
  match soldier {
    "特种兵" => "最强模型（白名单专属）"
    "炮兵" => "强力模型（LongCat/旗舰）"
    "侦查兵" => "便宜快速模型"
    "骑兵" => "低延迟中端模型"
    "通信兵" => "快速模型"
    "工兵" => "通用模型"
    "医疗兵" => "中端模型"
    "后勤兵" => "通用模型"
    _ => "未知档位"
  }
}
