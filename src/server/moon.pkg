import {
  "vicTop-cw/fist-mbt/src/core",
  "vicTop-cw/fist-mbt/src/store",
  "vicTop-cw/fist-mbt/src/engine",
  "vicTop-cw/fist-mbt/src/ops",
  "vicTop-cw/fist-mbt/src/omega",
  "vicTop-cw/fist-mbt/src/evolve",
  "vicTop-cw/fist-mbt/src/executor",
  "colmugx/mcp",
  "colmugx/mcp/protocol/types" @mcp_types,
  "colmugx/mcp/protocol/resource" @mcp_resource,
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbitlang/async/io",
  "moonbitlang/async/js_async",
}

supported_targets = "js+native"

// stdio_js/stdio_native 使用 io/js_async 等仅在各自 target 生效；
// json 在 native 测试端不需要, 统一压制 unused_package。

warnings = "-6-35"

options(
  targets: {
    "stdio_native.mbt": [ "native" ],
    "stdio_js.mbt": [ "js" ],
    "run_check_native.mbt": [ "native" ],
    "run_check_js.mbt": [ "js" ],
  },
)
