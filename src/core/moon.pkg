import {
  // BUG-468 R1：`test_crypto.mbt` 上提到 core 后需要 @mooncry（Ed25519 派生/签名）。
  // ⚠️ 这会让**所有依赖 core 的包**间接拿到 mooncry；
  //    实测 engine/router/server 本来就依赖它 ⇒ 实际只新增 2 个包。
  "cc06b/mooncry/lib" @mooncry,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/debug",
  "moonbitlang/x/encoding",
  // BUG-427 的接线格（bug427_strip_tail_wired）需要读源码断言实现真在。
  // 放主 import 而非 `for "test"`：实测 `for "test"` 在本包 wbtest 里不生效
  // （同 engine 包 BUG-413 踩过的坑：报 "Package fs not found in the loaded packages"）。
  // 生产代码不使用它；本包未设 warnings 抑制，unused_package 若告警属预期。
  "moonbitlang/x/fs",
}

import {
  "moonbitlang/core/quickcheck",
} for "wbtest"

supported_targets = "js+native"

options(
  link: { "native": { "cc-link-flags": "-lsqlite3" } },
)
